# Copia este archivo a .env.local. Nunca commitees valores reales.
# Local: `npx supabase start` imprime la URL y la publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio de la cookie de sesión compartida entre subdominios.
# Producción: .prismalab.com.co · Local: dejar vacío.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Solo tests de BD y scripts de seed. Nunca con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Dominio raíz de los subdominios de los spas ({slug}.ROOT_DOMAIN). Producción: prismalab.com.co
ROOT_DOMAIN=localhost
