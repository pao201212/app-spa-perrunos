# Copia a supabase/.env.local (el CLI de Supabase lo lee al hacer `npm run db:start`).
# Google Cloud Console → Credenciales → ID de cliente OAuth (Aplicación web).
# URI de redirección autorizado (local): http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
